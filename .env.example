# ──────────────────────────────────────────────────────────────────────
# Sentry — runtime crash & error reporting
# Get the DSN from https://sentry.io → Project → Settings → Client Keys
# Leave EMPTY to disable Sentry entirely (recommended for local dev).
# ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
# Slug used by `sentry-expo-upload-sourcemaps` during EAS builds.
EXPO_PUBLIC_SENTRY_ORG=
EXPO_PUBLIC_SENTRY_PROJECT=
# Auth token is used ONLY by CI / EAS for source-map upload — never bundled.
SENTRY_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Google Maps — required for react-native-maps on iOS & Android
# Get keys from https://console.cloud.google.com → APIs & Services → Credentials
# Restrict each key to the matching bundle id / package + Maps SDK only.
# ──────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# ──────────────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────────────
# Force-enable Sentry in __DEV__ when set to "1" (default: disabled in dev).
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=
# Override app environment label used by Sentry / logger ("development" | "staging" | "production")
APP_ENV=

# ──────────────────────────────────────────────────────────────────────
# Backend API
# Production MUST be HTTPS — cleartext is blocked by the platform.
# Example: https://api.hanamarket.uz/api
# ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=

# ──────────────────────────────────────────────────────────────────────
# Certificate pinning (production only)
# SPKI SHA-256 hashes (base64) of the API server's leaf certificate and a
# backup. The host is derived from EXPO_PUBLIC_API_URL automatically.
#
# Generate with:
#   openssl s_client -servername api.hanamarket.uz \
#     -connect api.hanamarket.uz:443 </dev/null \
#     | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der \
#     | openssl dgst -sha256 -binary | base64
#
# Leave EMPTY to skip pinning (still HTTPS-only in production).
# Setting only the primary pin without a backup risks bricking the app on
# certificate rotation — always include API_BACKUP_PIN_SHA256.
# ──────────────────────────────────────────────────────────────────────
API_PIN_SHA256=
API_BACKUP_PIN_SHA256=

# ──────────────────────────────────────────────────────────────────────
# Public legal & support URLs (shown in-app + on store listing)
# Override per environment if you maintain staging copies.
# ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
